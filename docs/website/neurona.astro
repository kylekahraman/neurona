---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Code } from 'astro:components';
import { readFileSync } from 'node:fs';
const source = (name) => readFileSync(`${process.cwd()}/public/neurona/files/${name}.typ`, 'utf8');
const lessons = [
  { id: 'cells', file: '01-cell', title: '1. Draw your first cell', text: 'Save this as examples/figure.typ in the downloaded folder. A circuit is a canvas; neuron adds a cell to it. The ID “pc” lets you refer to that cell later.', alt: 'A schematic pyramidal cell with branching apical and basal dendrites.' },
  { id: 'connections', file: '02-connections', title: '2. Connect two cells', text: 'Place cells with at: (x, y). The x coordinate runs right and y runs up. Connect named ports such as pc.axon and in.soma-west. An excitatory connection ends in an arrow; an inhibitory one ends in a bar. The via points let you choose the route.', alt: 'Pyramidal and basket-like cells with an excitatory arrow and an inhibitory return connection.' },
  { id: 'layers', file: '03-layers', title: '3. Put cells in layers', text: 'A region holds a stack of bands. cortical-layers() supplies six schematic neocortical layers, VI at the bottom and I at the top. site("ctx", "l5", 1.7) places the soma in layer V, 1.7 canvas units from the region’s left edge.', alt: 'Six cortical layers with a pyramidal cell positioned in layer V.' },
  { id: 'timelines', file: '04-timeline', title: '4. Describe an experiment', text: 'Use paradigm for a sequence of stimulus panels. Each stage has a title, duration label, and any Typst content as its display. This example uses equal panel spacing; the duration strings are labels.', alt: 'Four stimulus panels: fixation, target, delay, and response.' },
  { id: 'recipes', file: '05-motif', title: '5. Start from a circuit motif', text: 'For a common circuit, begin with a recipe. motif accepts "feedforward", "feedback", or "disinhibition". For an editable starting point, import motif-scene and use #circuit(..motif-scene("feedforward"), width: 85mm).', alt: 'A schematic feedforward inhibition motif.' },
  { id: 'custom', file: '06-custom', title: '6. Draw your own branches', text: 'Use kind: "custom" and neurite paths for a cell you author yourself. Points are relative to the soma. Each path exposes its endpoint as a port, such as custom.dendrite-0 or custom.axon-0, for later connections.', alt: 'A custom cell with three dendritic paths and an orange axon.' },
];
---
<SiteLayout current="projects" title="Neurona tutorial" description="A practical tutorial for drawing neurons, circuits, cortical layers, and experimental timelines with Neurona and Typst.">
  <section class="page-hero wrap tutorial-hero">
    <p class="eyebrow"><a href="/projects/">Projects</a> / Neurona · Development preview</p>
    <h1>Your neuroscience diagram,<br />written in Typst.</h1>
    <p class="page-lede">Start with a cell. Add connections, layers, or an experimental sequence. Edit a few lines and export a vector figure for your paper, poster, or slides.</p>
    <div class="hero-actions">
      <a class="button button-dark" href="/neurona/files/neurona-starter.zip" download>Download starter <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="#setup">Create your first figure <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-preview"><img src="/neurona/files/02-connections.svg" alt="A pyramidal cell connected to an inhibitory cell, drawn with Neurona." width="720" height="340" /></div>
    <p class="preview-caption">Code you can edit. Labels you can typeset. Vector artwork you can scale.</p>
  </section>
  <div class="wrap tutorial-layout">
    <nav class="tutorial-nav" aria-label="Tutorial contents">
      <p class="eyebrow">On this page</p>
      <a href="#setup">Get set up</a>
      {lessons.map((lesson) => <a href={`#${lesson.id}`}>{lesson.title}</a>)}
      <a href="#customize">Make it yours</a><a href="#export">Export your figure</a><a href="#help">Common questions</a>
    </nav>
    <article class="tutorial-body">
      <section id="setup">
        <p class="eyebrow">Get started</p><h2>A folder, a text file, a figure.</h2>
        <p>Neurona is a drawing toolkit for <a href="https://typst.app/">Typst</a>, a text-based typesetting system. You describe a figure in a <code>.typ</code> file; Typst turns it into a PDF, SVG, or PNG.</p>
        <ol>
          <li><a href="/neurona/files/neurona-starter.zip" download>Download the starter</a> and extract it. It includes the library and all six tutorial examples.</li>
          <li><strong>In your browser:</strong> create a blank project in the <a href="https://typst.app/">Typst web app</a>. Upload <code>lib.typ</code>, the entire <code>src/</code> folder, and <code>examples/</code>, preserving their folder structure. Choose <code>examples/01-cell.typ</code> as the main file.</li>
          <li><strong>On your computer:</strong> <a href="https://github.com/typst/typst#installation">install the Typst CLI</a>. Open a terminal in the extracted <code>neurona-starter/</code> folder and run:</li>
        </ol>
        <Code code={'typst compile --root . examples/01-cell.typ figure.pdf'} lang="bash" />
        <p>Open <code>figure.pdf</code> to see your first cell. To edit while previewing locally, use <code>typst watch</code> in place of <code>typst compile</code>.</p>
        <aside class="note">This starter contains the current development version. Use its local imports; Neurona is not yet published as an <code>@preview/neurona</code> package. The CeTZ drawing dependency is fetched on first compilation, so that first run needs internet access.</aside>
      </section>
      {lessons.map((lesson) => <section id={lesson.id}>
        <h2>{lesson.title}</h2><p>{lesson.text}</p>
        <figure class="lesson-preview"><img src={`/neurona/files/${lesson.file}.svg`} alt={lesson.alt} loading="lazy" /></figure>
        <div class="code-heading"><span>{`examples/${lesson.file}.typ`}</span><button type="button" data-copy={lesson.file} aria-label={`Copy code for ${lesson.title}`}>Copy code</button></div>
        <div data-source={lesson.file}><Code code={source(lesson.file)} lang="typst" /></div>
        <p class="downloads"><a href={`/neurona/files/${lesson.file}.typ`} download>Download Typst source ↓</a><a href={`/neurona/files/${lesson.file}.svg`} download>Download SVG ↓</a></p>
        {lesson.id === 'cells' && <p>Keep the trailing comma in a one-item list: <code>(neuron("pc"),)</code>. Replace the label, then recompile. Every example below is a complete file; save it inside <code>examples/</code> so that <code>../lib.typ</code> resolves correctly.</p>}
        {lesson.id === 'connections' && <p>Give each cell a unique ID without dots. Try targeting <code>pc.basal</code>, <code>pc.apical</code>, or <code>pc.tuft</code> instead. Ports depend on the glyph: these compartments belong to the pyramidal cell. Crossings and overlapping branches do not create synapses.</p>}
        {lesson.id === 'layers' && <p>For your own layers, import <code>band</code> and replace <code>cortical-layers()</code> with a tuple such as <code>(band("deep", height: 1), band("upper", height: 2))</code>. List bands bottom-to-top. Changing a layer moves its soma sites; dendrites keep the explicit lengths you set.</p>}
        {lesson.id === 'timelines' && <p>For duration-scaled panels, give stages numeric durations in seconds and use <code>spacing: "proportional"</code>. For overlapping events, use <code>timeline</code> with <code>layout: "axis"</code> or <code>"lanes"</code>, and numeric <code>start</code> and <code>end</code> values. Extremely short stages are clearer on a time axis.</p>}
      </section>)}
      <section id="customize"><h2>Make it yours</h2>
        <p>Start from the closest example, change one thing, and recompile. Positions and branch lengths use canvas units; the default unit is one centimetre.</p>
        <div class="table-scroll"><table><thead><tr><th>To change…</th><th>Edit…</th></tr></thead><tbody>
          <tr><td>The cell shape</td><td><code>kind: "pyramidal"</code>, <code>"granule"</code>, <code>"stellate"</code>, <code>"horizontal"</code>, <code>"basket"</code>, or <code>"bipolar"</code></td></tr>
          <tr><td>Branch geometry</td><td><code>apical: 2.2, basal: 0.75, spread: 0.52</code></td></tr>
          <tr><td>Cell size or rotation</td><td><code>scale: 0.8, orientation: 30deg</code></td></tr>
          <tr><td>Color and labels</td><td><code>color: rgb("bd674b"), label: [My cell]</code></td></tr>
          <tr><td>Simpler branches</td><td><code>detail: "minimal"</code> on a neuron</td></tr>
          <tr><td>A curved connection</td><td><code>controls: ((1, -2), (2, -2))</code> instead of <code>via</code>; use one or two control points</td></tr>
          <tr><td>The final figure width</td><td><code>width: 85mm</code> on a circuit; scales labels and strokes too</td></tr>
          <tr><td>Geometry with fixed text size</td><td><code>unit: 8mm, font-size: 9pt</code> on a circuit, omitting <code>width</code></td></tr>
        </tbody></table></div>
        <aside class="note">These are schematic drawings. Cell shape and color do not establish biological identity or connectivity. You choose the connections and their meaning; positions, layer thicknesses, and branching are not measured anatomy.</aside>
      </section>
      <section id="export"><h2>Export for your paper or slides</h2>
        <p>Run these commands from the extracted starter folder after saving your drawing as <code>examples/figure.typ</code>:</p>
        <Code code={'typst compile --root . examples/figure.typ figure.pdf\ntypst compile --root . examples/figure.typ figure.svg\ntypst compile --root . examples/figure.typ figure.png --ppi 300'} lang="bash" />
        <p>PDF and SVG preserve vector artwork. PNG is useful when a tool needs a raster image. In the Typst web app, use its export menu. Keep <code>#set page(width: auto, height: auto, margin: 3mm)</code> for a page cropped around the figure.</p>
      </section>
      <section id="help"><h2>If something looks wrong</h2>
        <dl><dt>“File not found” or an import outside the project root</dt><dd>Keep <code>lib.typ</code> beside <code>src/</code>, and the drawing inside <code>examples/</code>. Run the CLI from the starter folder with <code>--root .</code>. In the web app, preserve that folder structure.</dd>
          <dt>A connection passes through a cell</dt><dd>Add explicit <code>via</code> waypoints or <code>controls</code> handles, or move the cells. Connections currently need authored routes.</dd>
          <dt>My labels became too small</dt><dd><code>width</code> fits the entire figure, including text. Increase the width, simplify the scene, or omit width and choose <code>unit</code> and <code>font-size</code> separately.</dd>
          <dt>I need richer examples</dt><dd>The starter includes <code>README.md</code> with the API reference, <code>docs/</code> with recipe notes, and additional examples for CA1 layers, regional networks, interneuron recipes, and timelines.</dd>
        </dl>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </section>
    </article>
  </div>
</SiteLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = document.querySelector(`[data-source="${button.dataset.copy}"] code`);
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = 'Copied';
        window.setTimeout(() => { button.textContent = 'Copy code'; }, 2000);
      } catch {
        button.textContent = 'Select code to copy';
        const range = document.createRange(); range.selectNodeContents(code);
        const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(range);
      }
    });
  });
</script>
<style>
  .tutorial-hero { padding-bottom: 48px; }
  .tutorial-hero h1 { max-width: 900px; }
  .tutorial-hero .page-lede { max-width: 680px; }
  .hero-preview { margin-top: 44px; background: white; border: 1px solid var(--line); padding: 28px; }
  .hero-preview img { display: block; width: 100%; height: 300px; object-fit: contain; }
  .preview-caption { color: var(--muted); font-size: .8rem; margin-top: 12px; }
  .tutorial-layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 64px; align-items: start; padding-bottom: 100px; }
  .tutorial-nav { position: sticky; top: 30px; display: grid; gap: 10px; padding-top: 28px; border-top: 1px solid var(--line); font-size: .8rem; }
  .tutorial-nav a:hover { color: var(--rust); }
  .tutorial-body { min-width: 0; }
  .tutorial-body section { scroll-margin-top: 28px; border-top: 1px solid var(--line); padding: 28px 0 40px; }
  .tutorial-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 18px; }
  .tutorial-body p, .tutorial-body li, dd { color: #4f5d56; font-size: .95rem; }
  .tutorial-body li { padding-left: 4px; margin-bottom: 14px; }
  .tutorial-body a { text-decoration: underline; text-underline-offset: 4px; color: var(--green); }
  code { font-family: var(--mono); font-size: .85em; overflow-wrap: anywhere; }
  :global(.tutorial-body pre) { overflow-x: auto; padding: 22px; border: 1px solid var(--line); font-size: .82rem; line-height: 1.7; border-radius: 2px; }
  :global(.tutorial-body pre code) { overflow-wrap: normal; }
  .note { margin: 24px 0 0; padding: 18px 22px; background: var(--paper-deep); border-left: 3px solid var(--rust); font-size: .86rem; }
  .lesson-preview { margin: 24px 0; padding: 24px; background: white; border: 1px solid var(--line); }
  .lesson-preview img { display: block; width: 100%; max-height: 300px; object-fit: contain; }
  .code-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; font: .73rem var(--mono); color: var(--muted); }
  button { padding: 8px 12px; font: inherit; color: var(--green); background: transparent; border: 1px solid var(--line); cursor: pointer; }
  button:hover { background: var(--green-light); }
  button:focus-visible { outline: 2px solid var(--rust); outline-offset: 3px; }
  .downloads { display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: .8rem !important; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .86rem; }
  th, td { padding: 14px 12px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--green); } th:first-child { min-width: 150px; }
  dt { font-weight: 600; margin-top: 24px; } dd { margin: 8px 0 0; }
  @media (max-width: 800px) { .tutorial-layout { grid-template-columns: 1fr; gap: 24px; } .tutorial-nav { position: static; grid-template-columns: 1fr 1fr; } .tutorial-nav .eyebrow { grid-column: 1 / -1; } .hero-preview img { height: 240px; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
